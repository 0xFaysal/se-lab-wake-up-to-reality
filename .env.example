# =============================================================
# UIU SE Lab — Environment Variables Template
# =============================================================
#
# HOW TO USE THIS FILE:
#   cp .env.example .env
#   Then open .env and fill in your actual values.
#
# RULES:
#   ✅ .env.example  → safe to commit (contains NO real secrets)
#   ❌ .env          → NEVER commit (contains your real secrets)
#
# =============================================================
# UNDERSTANDING THE TWO CONTEXTS
# =============================================================
#
# This project runs inside Docker. There are TWO different
# "perspectives" for network addresses:
#
# [1] YOUR BROWSER (outside Docker)
#     → Uses localhost + the port Docker maps to your machine
#     → Frontend:  http://localhost:3000
#     → Backend:   http://localhost:8000
#     → Database:  localhost:5432  (via DB tool like DBeaver)
#
# [2] INSIDE DOCKER (container-to-container)
#     → Uses the service NAME defined in docker-compose.yml
#     → Backend reaches DB as:    db:5432        (not localhost)
#     → Backend is reachable as:  backend:8000   (not localhost)
#     → Frontend SSR calls API as: backend:8000  (not localhost)
#
# The variables below use the correct address for each context.
# =============================================================


# -------------------------------------------------------------
# BACKEND (Django / Laravel / Spring Boot / Express)
# -------------------------------------------------------------

# Django secret key — generate a new one for production
# Generate: python -c "from django.core.signing import Signer; print(Signer().signature('key'))"
# Or use:   https://djecrety.ir/
SECRET_KEY=replace-with-a-long-random-string-here

# Set to False in production — NEVER True in production
DEBUG=True

# Hosts allowed to access the backend
# Comma-separated. Add your domain here when deploying.
ALLOWED_HOSTS=localhost,127.0.0.1


# -------------------------------------------------------------
# DATABASE
# Used by: backend container (connects to db container)
# Address context: INSIDE Docker → service name = "db"
# -------------------------------------------------------------

DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=replace-with-a-strong-password-here
DB_HOST=db          # ← "db" is the Docker service name, NOT localhost
DB_PORT=5432


# -------------------------------------------------------------
# FRONTEND (React / Vue / Angular)
# Used by: the browser running on the STUDENT'S MACHINE
# Address context: OUTSIDE Docker → use localhost
# -------------------------------------------------------------

# This URL is called by the student's browser, not by Docker.
# The browser is outside Docker, so it uses localhost + the
# port that Docker maps from the backend container.
REACT_APP_API_URL=http://localhost:8000/api

# If you are using Next.js with Server-Side Rendering (SSR),
# the server-side fetch runs INSIDE Docker and needs:
# NEXT_PUBLIC_API_URL=http://backend:8000/api  ← internal Docker name
# (uncomment and use this instead for Next.js SSR)


# -------------------------------------------------------------
# OPTIONAL — Redis (if you add caching or task queues)
# Address context: INSIDE Docker → service name = "redis"
# -------------------------------------------------------------

# REDIS_HOST=redis    # Docker service name
# REDIS_PORT=6379


# -------------------------------------------------------------
# OPTIONAL — Email (for password reset, notifications)
# -------------------------------------------------------------

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password-here


# -------------------------------------------------------------
# OPTIONAL — JWT Settings
# -------------------------------------------------------------

# ACCESS_TOKEN_LIFETIME_MINUTES=60
# REFRESH_TOKEN_LIFETIME_DAYS=7
