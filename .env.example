# =============================================================
# UIU SE Lab — Environment Variables Template
# =============================================================
# HOW TO USE:
#   cp .env.example .env
#   Open .env and fill in your actual values
#
# RULES:
#   .env.example  → SAFE to commit (no real secrets here)
#   .env          → NEVER commit (contains real secrets)
#
# =============================================================
# UNDERSTANDING localhost vs Docker service names
# =============================================================
#
# YOUR BROWSER (outside Docker) uses:
#   Frontend  → http://localhost:3000
#   Backend   → http://localhost:8000
#   Database  → localhost:5432  (via DBeaver / TablePlus)
#
# INSIDE DOCKER (container-to-container) uses service names:
#   Backend reaches DB  → db:5432       NOT localhost
#   One container calls another → backend:8000  NOT localhost
#
# =============================================================

# --- Backend ---
SECRET_KEY=replace-with-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (used by backend container, INSIDE Docker) ---
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=replace-with-a-strong-password-here
DB_HOST=db        # "db" is the Docker service name, NOT localhost
DB_PORT=5432

# --- Frontend (used by the BROWSER, OUTSIDE Docker) ---
REACT_APP_API_URL=http://localhost:8000/api
# Note: if using Next.js SSR, server-side calls need:
# NEXT_PUBLIC_API_URL=http://backend:8000/api  (internal Docker name)
