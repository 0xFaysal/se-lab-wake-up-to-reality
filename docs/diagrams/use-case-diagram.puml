@startuml use-case-diagram
!theme plain
title ParkEase BD — Use Case Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam actor {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

left to right direction

actor "Driver" as Driver
actor "Parking Owner" as Owner
actor "Security Guard" as Guard
actor "Administrator" as Admin
actor "SSLCOMMERZ\n(Payment Gateway)" as SSL

rectangle "ParkEase BD" {

  package "Driver Use Cases" {
    usecase "Register / Login" as UC1
    usecase "Manage Vehicles" as UC2
    usecase "Search Parking" as UC3
    usecase "View Parking Details" as UC4
    usecase "Request Quote" as UC5
    usecase "Create Booking Hold" as UC6
    usecase "Make Payment" as UC7
    usecase "View Booking &\nAccess QR/OTP" as UC8
    usecase "Request Extension" as UC9
    usecase "Request Checkout" as UC10
    usecase "View Payment &\nRefund History" as UC11
    usecase "Submit Review" as UC12
    usecase "Submit Dispute" as UC13
  }

  package "Parking Owner Use Cases" {
    usecase "Manage Properties" as UC14
    usecase "Manage Parking Spots" as UC15
    usecase "Manage Availability\n& Exceptions" as UC16
    usecase "Create / Invite Guards" as UC17
    usecase "Manage Guard\nAssignments" as UC18
    usecase "View Bookings\n& Active Sessions" as UC19
    usecase "View Earnings" as UC20
    usecase "Manage Payout Accounts" as UC21
    usecase "Request Payout" as UC22
    usecase "Respond to Disputes" as UC23
  }

  package "Security Guard Use Cases" {
    usecase "Accept / Reject\nAssignment" as UC24
    usecase "View Expected Arrivals" as UC25
    usecase "Verify Entry (QR/OTP)" as UC26
    usecase "Confirm Check-in" as UC27
    usecase "View Active Vehicles" as UC28
    usecase "Verify Exit (QR/OTP)" as UC29
    usecase "Confirm Checkout" as UC30
    usecase "Report Incident" as UC31
  }

  package "Administrator Use Cases" {
    usecase "Verify / Reject /\nSuspend Property" as UC32
    usecase "Manage Users" as UC33
    usecase "Manage Guard\nGlobal Accounts" as UC34
    usecase "Override Booking" as UC35
    usecase "Resolve Disputes" as UC36
    usecase "Verify Payout Accounts" as UC37
    usecase "Approve Payouts" as UC38
    usecase "Reconcile Payments" as UC39
    usecase "View Audit Logs" as UC40
    usecase "Manage Platform Settings" as UC41
  }
}

Driver --> UC1
Driver --> UC2
Driver --> UC3
Driver --> UC4
Driver --> UC5
Driver --> UC6
Driver --> UC7
Driver --> UC8
Driver --> UC9
Driver --> UC10
Driver --> UC11
Driver --> UC12
Driver --> UC13

UC6 ..> UC5 : <<include>>
UC7 ..> SSL : <<include>>
UC9 ..> UC5 : <<include>>
UC10 ..> UC8 : <<extend>>

Owner --> UC1
Owner --> UC14
Owner --> UC15
Owner --> UC16
Owner --> UC17
Owner --> UC18
Owner --> UC19
Owner --> UC20
Owner --> UC21
Owner --> UC22
Owner --> UC23

UC14 ..> UC32 : <<include>>\n(submit for verification)

Guard --> UC1
Guard --> UC24
Guard --> UC25
Guard --> UC26
Guard --> UC27
Guard --> UC28
Guard --> UC29
Guard --> UC30
Guard --> UC31

UC26 ..> UC27 : <<precedes>>
UC29 ..> UC30 : <<precedes>>

Admin --> UC1
Admin --> UC32
Admin --> UC33
Admin --> UC34
Admin --> UC35
Admin --> UC36
Admin --> UC37
Admin --> UC38
Admin --> UC39
Admin --> UC40
Admin --> UC41

@enduml
