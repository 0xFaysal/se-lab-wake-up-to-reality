@startuml use-case-property
!theme plain
title ParkEase BD: Use Case Diagram (b) Provider & Manager

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam actor {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

left to right direction

actor "Provider" as Provider
actor "Manager" as Manager
actor "Property Operator" as Operator <<abstract>>

rectangle "ParkEase BD" {

  usecase "Register / Login" as UC1

  package "Provider-only Use Cases" {
    usecase "Create Property or\nJoin Existing Property" as UC30
    usecase "Claim Parking Right\n(with evidence)" as UC31
    usecase "Delegate to Manager\n(permissions + scope)" as UC32
    usecase "Manage Payout Methods\n& Request Payouts" as UC33
    usecase "Reply to Reviews" as UC34
    usecase "Open / View Disputes" as UC35
    usecase "Vote on Building Manager\n& Change Proposals" as UC36
  }

  package "Property Operations (Provider, or Manager with permission)" {
    usecase "Manage Parking Resources" as UC40
    usecase "Manage Listings & Pricing" as UC41
    usecase "Manage Availability\n& Exceptions" as UC42
    usecase "Manage Property Images" as UC43
    usecase "View Bookings\n& Live Sessions" as UC44
    usecase "Add Guards to Property" as UC45
    usecase "Assign Guard Shifts" as UC46
    usecase "View Earnings\n& Reports" as UC47
  }

  package "Shared Property Rules (sole Provider or Building Manager)" {
    usecase "Set Common Rules /\nTemporary Closure" as UC51
  }

  package "Manager-only Use Cases" {
    usecase "Accept / Reject\nDelegation" as UC50
  }

}

Provider -- UC1
Provider -- UC30
Provider -- UC31
Provider -- UC32
Provider -- UC33
Provider -- UC34
Provider -- UC35
Provider -- UC36

UC41 ..> UC31 : <<requires>>\nverified right

Operator -- UC40
Operator -- UC41
Operator -- UC42
Operator -- UC43
Operator -- UC44
Operator -- UC45
Operator -- UC46
Operator -- UC47
Provider -up-|> Operator
Manager -up-|> Operator

note bottom of Operator
  A Manager performs an operation only
  with the matching delegated permission
  and inside the delegated scope.
end note

UC1 -- Manager
UC50 -- Manager
UC51 -- Manager : as Building\nManager
Provider -- UC51 : as sole\nProvider

UC50 ..> UC40 : <<precedes>>
UC32 ..> UC50 : <<precedes>>

@enduml
