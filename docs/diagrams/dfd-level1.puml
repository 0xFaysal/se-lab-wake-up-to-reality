@startuml dfd-level1
!theme plain
title ParkEase BD: Data Flow Diagram (Level 1)

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 12
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam database {
  BackgroundColor #E1F5FE
  BorderColor #01579B
}
skinparam rectangle {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

actor "User" as User
actor "Provider" as Provider
actor "Manager" as Manager
actor "Security\nGuard" as Guard
actor "Administrator" as Admin
rectangle "SSLCOMMERZ\nGateway" as SSL

usecase "1.0\nManage Accounts,\nAuthentication\n& Sessions" as P1
usecase "2.0\nManage Properties,\nMemberships &\nGovernance" as P2
usecase "3.0\nManage Resources,\nParking Rights,\nListings & Availability" as P3
usecase "4.0\nManage Guards &\nManager Delegations" as P4
usecase "5.0\nSearch & Discover\nParking" as P5
usecase "6.0\nQuote, Hold\n& Booking" as P6
usecase "7.0\nPayments, Refunds\n& Settlement" as P7
usecase "8.0\nGate Verification\n& Sessions" as P8
usecase "9.0\nWallets, Earnings\n& Payouts" as P9
usecase "10.0\nReviews, Disputes,\nReports & Notifications" as P10
usecase "11.0\nAdmin Oversight,\nContent & Audit" as P11

database "D1  Accounts, Roles, Sessions,\nTokens, Legal Acceptances" as D1
database "D2  Vehicles, Favorites,\nSaved Places, Searches" as D2
database "D3  Properties, Images,\nProvider Memberships,\nGovernance, Proposals" as D3
database "D4  Parking Resources, Units,\nRights, Evidence, Listings,\nAvailability" as D4
database "D5  Guard Memberships &\nAssignments, Manager\nDelegations" as D5
database "D6  Quotes, Holds, Allocations,\nBookings, Access Credentials" as D6
database "D7  Payments, Refunds,\nSettlements, Ledger,\nWallets, Payouts, Fee Rules" as D7
database "D8  Reviews, Disputes, Listing\nReports, Notifications" as D8
database "D9  Audit Events, Risk Flags,\nContent, Email Campaigns" as D9

User <--> P1
Provider <--> P1
Manager <--> P1 : setup link
Guard <--> P1 : setup link
Admin <--> P1
P1 <--> D1

Provider <--> P2 : property, images,\njoin requests, votes
Manager <--> P2 : common rules,\nclosure (Building Manager)
P2 <--> D3
P2 --> P11 : property / membership\nfor verification
P11 --> P2 : decision, merge

Provider <--> P3 : resources, right claims,\nlistings, availability
Manager <--> P3 : within delegated\npermissions
P3 <--> D4
P3 --> P11 : right claims
P11 --> P3 : verify / reject,\nsuspend listing

Provider --> P4 : add Guards, shifts,\ndelegations
Guard <--> P4 : accept / reject
Manager <--> P4 : accept / reject
P4 --> P1 : create controlled account
P4 <--> D5

User --> P5 : location, time,\nvehicle type
P5 --> User : verified offers
P5 --> D4 : read active listings\n& availability
P5 <--> D2

User <--> P6 : quote, hold, booking,\ncancel, checkout request
P6 <--> D6
P6 --> D4 : check availability
P6 --> P7 : payment request

P7 <--> SSL : session, validation,\nrefund
P7 <--> D7
P7 --> D6 : confirm booking,\nissue credential
P7 --> User : payment status

Guard <--> P8 : QR credential,\ncheck-in / check-out
P8 --> D5 : check active assignment
P8 <--> D6
P8 --> P7 : overtime settlement

Provider <--> P9 : earnings, payout\nmethods, payout requests
User <--> P9 : Refund Balance,\nwithdrawals
P9 <--> D7
P9 --> P11 : payout queue
P11 --> P9 : hold / approve /\nreject / paid

User --> P10 : review, dispute,\nlisting report
Provider <--> P10 : review reply,\ndispute
P10 <--> D8
P10 --> P11 : disputes, reports
P11 --> P10 : resolution

Admin <--> P11
P11 <--> D9

@enduml
