@startuml use-case-booking
!theme plain
title ParkEase BD: Use Case Diagram (a) Booking & Gate Operations

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam actor {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

left to right direction

actor "Driver" as Driver
actor "Security Guard" as Guard
actor "SSLCOMMERZ\n(Payment Gateway)" as SSL

rectangle "ParkEase BD" {

  usecase "Register / Login" as UC1

  package "Driver Use Cases" {
    usecase "Manage Vehicles" as UC2
    usecase "Search Parking" as UC3
    usecase "View Parking Details" as UC4
    usecase "Request Quote" as UC5
    usecase "Create Booking Hold" as UC6
    usecase "Make Payment" as UC7
    usecase "View Booking &\nAccess QR/OTP" as UC8
    usecase "Request Extension" as UC9
    usecase "Request Checkout" as UC10
    usecase "View Payment &\nRefund History" as UC11
    usecase "Submit Review" as UC12
    usecase "Submit Dispute" as UC13
  }

  package "Security Guard Use Cases" {
    usecase "Accept / Reject\nAssignment" as UC24
    usecase "View Expected Arrivals" as UC25
    usecase "Verify Entry (QR/OTP)" as UC26
    usecase "Confirm Check-in" as UC27
    usecase "View Active Vehicles" as UC28
    usecase "Verify Exit (QR/OTP)" as UC29
    usecase "Confirm Checkout" as UC30
    usecase "Report Incident" as UC31
  }
}

' --- Driver (left) ---
Driver -- UC1
Driver -- UC2
Driver -- UC3
Driver -- UC4
Driver -- UC5
Driver -- UC6
Driver -- UC7
Driver -- UC8
Driver -- UC9
Driver -- UC10
Driver -- UC11
Driver -- UC12
Driver -- UC13

UC6 ..> UC5 : <<include>>
UC9 ..> UC5 : <<include>>
UC10 ..> UC8 : <<extend>>
UC7 ..> SSL : <<include>>

' --- Security Guard (left) ---
Guard -- UC1
Guard -- UC24
Guard -- UC25
Guard -- UC26
Guard -- UC27
Guard -- UC28
Guard -- UC29
Guard -- UC30
Guard -- UC31

UC26 ..> UC27 : <<precedes>>
UC29 ..> UC30 : <<precedes>>

@enduml
