@startuml use-case-booking
!theme plain
title ParkEase BD: Use Case Diagram (a) Booking & Gate Operations

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam actor {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

left to right direction

actor "User" as User
actor "Security Guard" as Guard
actor "SSLCOMMERZ\n(Payment Gateway)" as SSL

rectangle "ParkEase BD" {

  usecase "Register / Login /\nVerify Email" as UC1

  package "User Use Cases" {
    usecase "Manage Vehicles" as UC2
    usecase "Search & Browse Parking\n(map, filters)" as UC3
    usecase "Manage Favorites, Saved\nPlaces, Recent Searches" as UC4
    usecase "Request Quote" as UC5
    usecase "Hold Parking (5 min)" as UC6
    usecase "Create Booking" as UC7
    usecase "Pay (Refund Balance\nfirst, then gateway)" as UC8
    usecase "View Booking &\nQR Access Pass" as UC9
    usecase "Cancel Booking" as UC10
    usecase "Request Checkout" as UC11
    usecase "Pay Outstanding\nOvertime" as UC12
    usecase "Review Booking" as UC13
    usecase "Open Dispute" as UC14
    usecase "Report Listing" as UC15
    usecase "Withdraw Refund Balance" as UC16
  }

  package "Security Guard Use Cases" {
    usecase "Accept / Reject\nProperty Invitation" as UC20
    usecase "View Assigned Bookings" as UC21
    usecase "Verify QR Credential" as UC22
    usecase "Confirm Check-in" as UC23
    usecase "View Active Sessions" as UC24
    usecase "Confirm Check-out" as UC25
  }
}

User -- UC1
User -- UC2
User -- UC3
User -- UC4
User -- UC5
User -- UC6
User -- UC7
User -- UC8
User -- UC9
User -- UC10
User -- UC11
User -- UC12
User -- UC13
User -- UC14
User -- UC15
User -- UC16

UC6 ..> UC5 : <<include>>
UC7 ..> UC6 : <<include>>
UC8 ..> SSL : <<include>>\n(when balance\nis not enough)
UC12 ..> SSL : <<include>>
UC11 ..> UC9 : <<extend>>

Guard -- UC1
Guard -- UC20
Guard -- UC21
Guard -- UC22
Guard -- UC23
Guard -- UC24
Guard -- UC25

UC22 ..> UC23 : <<precedes>>
UC20 ..> UC21 : <<precedes>>

@enduml
