{
  "name": "parkease-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/auth/phone.test.ts tests/unit/auth/auth-schema.test.ts tests/unit/auth/authorization.test.ts tests/unit/vehicles/registration-number.test.ts tests/unit/vehicles/vehicle-validation.test.ts tests/unit/properties/property-validation.test.ts tests/unit/properties/property-policy.test.ts tests/unit/properties/encryption.test.ts",
    "test:auth": "tsx --test tests/unit/auth/phone.test.ts tests/unit/auth/auth-schema.test.ts tests/unit/auth/authorization.test.ts",
    "test:vehicles": "tsx --test tests/unit/vehicles/registration-number.test.ts tests/unit/vehicles/vehicle-validation.test.ts",
    "test:properties": "tsx --test tests/unit/properties/property-validation.test.ts tests/unit/properties/property-policy.test.ts tests/unit/properties/encryption.test.ts",
    "test:integration": "tsx --test tests/integration/auth/auth.integration.test.ts tests/integration/vehicles/vehicles.integration.test.ts tests/integration/properties/properties.integration.test.ts",
    "test:vehicles:integration": "tsx --test tests/integration/vehicles/vehicles.integration.test.ts",
    "test:properties:integration": "tsx --test tests/integration/properties/properties.integration.test.ts",
    "test:all": "npm run test && npm run test:integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.1.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true
  }
}
