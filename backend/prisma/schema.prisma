  providerUserId            String        @map("provider_user_id") @db.Uuid
  settlementRecipientUserId String        @map("settlement_recipient_user_id") @db.Uuid
  settlementWalletAccountId String        @map("settlement_wallet_account_id") @db.Uuid
  startAt                   DateTime      @map("start_at") @db.Timestamptz(6)
  scheduledEndAt            DateTime      @map("scheduled_end_at") @db.Timestamptz(6)
  effectiveEndAt            DateTime      @map("effective_end_at") @db.Timestamptz(6)
  baseAmountPaisa           BigInt        @map("base_amount_paisa")
  platformFeePaisa          BigInt        @map("platform_fee_paisa")
  depositPaisa              BigInt        @map("deposit_paisa")
  totalAmountPaisa          BigInt        @map("total_amount_paisa")
  status                    BookingStatus @default(PAYMENT_PENDING)
  idempotencyKey            String        @map("idempotency_key") @db.VarChar(100)
  confirmedAt               DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  checkedInAt               DateTime?     @map("checked_in_at") @db.Timestamptz(6)
  checkoutRequestedAt       DateTime?     @map("checkout_requested_at") @db.Timestamptz(6)
  checkedOutAt              DateTime?     @map("checked_out_at") @db.Timestamptz(6)
  cancelledAt               DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  hold                    ReservationHold   @relation(fields: [holdId], references: [id], onDelete: Restrict)
  allocation              ParkingAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  driver                  User              @relation("BookingDriver", fields: [driverUserId], references: [id], onDelete: Restrict)
  vehicle                 Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  property                Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  parkingSpot             ParkingSpot       @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict)
  listing                 ParkingListing    @relation(fields: [listingId], references: [id], onDelete: Restrict)
  parkingRight            ParkingRight      @relation(fields: [parkingRightId], references: [id], onDelete: Restrict)
  provider                User              @relation("BookingProvider", fields: [providerUserId], references: [id], onDelete: Restrict)
  settlementRecipient     User              @relation("BookingSettlementRecipient", fields: [settlementRecipientUserId], references: [id], onDelete: Restrict)
  settlementWalletAccount WalletAccount     @relation("BookingSettlementWallet", fields: [settlementWalletAccountId], references: [id], onDelete: Restrict)
  credential              AccessCredential?
  payments                Payment[]
  review                  Review?
  dispute                 Dispute?

  @@unique([driverUserId, idempotencyKey])
  @@index([driverUserId, createdAt(sort: Desc)])
  @@index([providerUserId, status, startAt])
  @@index([propertyId, status, startAt])
  @@map("bookings")
}

model AccessCredential {
  id        String                 @id @default(uuid()) @db.Uuid
  bookingId String                 @unique @map("booking_id") @db.Uuid
  tokenHash String                 @unique @map("token_hash") @db.VarChar(64)
  status    AccessCredentialStatus @default(ACTIVE)
  expiresAt DateTime               @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?              @map("used_at") @db.Timestamptz(6)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("access_credentials")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  payerUserId       String        @map("payer_user_id") @db.Uuid
  amountPaisa       BigInt        @map("amount_paisa")
  currency          String        @default("BDT") @db.Char(3)
  status            PaymentStatus @default(PENDING)
  provider          String        @default("SIMULATED") @db.VarChar(30)
  providerReference String?       @unique @map("provider_reference") @db.VarChar(120)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(100)
  capturedAt        DateTime?     @map("captured_at") @db.Timestamptz(6)
  failedAt          DateTime?     @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payer   User     @relation("PaymentPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([bookingId, status])
  @@index([payerUserId, createdAt(sort: Desc)])
  @@map("payments")
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  requestedByUserId String       @map("requested_by_user_id") @db.Uuid
  amountPaisa       BigInt       @map("amount_paisa")
  reason            String       @db.VarChar(500)
  status            RefundStatus @default(PENDING)
  idempotencyKey    String       @unique @map("idempotency_key") @db.VarChar(100)
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@map("refunds")
}

model PayoutRequest {
  id              String       @id @default(uuid()) @db.Uuid
  providerUserId  String       @map("provider_user_id") @db.Uuid
  walletAccountId String       @map("wallet_account_id") @db.Uuid
  amountPaisa     BigInt       @map("amount_paisa")
  status          PayoutStatus @default(PENDING)
  idempotencyKey  String       @unique @map("idempotency_key") @db.VarChar(100)
  reviewedById    String?      @map("reviewed_by_id") @db.Uuid
  reviewNote      String?      @map("review_note") @db.VarChar(500)
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  paidAt          DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider      User          @relation("PayoutProvider", fields: [providerUserId], references: [id], onDelete: Restrict)
  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)

  @@index([providerUserId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payout_requests")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(150)
  message        String           @db.VarChar(500)
  entityType     String?          @map("entity_type") @db.VarChar(50)
  entityId       String?          @map("entity_id") @db.Uuid
  idempotencyKey String?          @map("idempotency_key") @db.VarChar(120)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model Review {
  id                  String    @id @default(uuid()) @db.Uuid
  bookingId           String    @unique @map("booking_id") @db.Uuid
  driverUserId        String    @map("driver_user_id") @db.Uuid
  rating              Int       @db.SmallInt
  comment             String?   @db.VarChar(2000)
  providerReply       String?   @map("provider_reply") @db.VarChar(2000)
  providerRepliedById String?   @map("provider_replied_by_id") @db.Uuid
  providerRepliedAt   DateTime? @map("provider_replied_at") @db.Timestamptz(6)
  reportedAt          DateTime? @map("reported_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking           Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  driver            User    @relation("ReviewDriver", fields: [driverUserId], references: [id], onDelete: Restrict)
  providerRepliedBy User?   @relation("ReviewProvider", fields: [providerRepliedById], references: [id], onDelete: Restrict)

  @@index([driverUserId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Dispute {
  id               String          @id @default(uuid()) @db.Uuid
  bookingId        String          @unique @map("booking_id") @db.Uuid
  openedByUserId   String          @map("opened_by_user_id") @db.Uuid
  category         DisputeCategory
  description      String          @db.VarChar(3000)
  evidence         Json?
  status           DisputeStatus   @default(OPEN)
  resolution       String?         @db.VarChar(3000)
  resolvedByUserId String?         @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  openedBy   User    @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  resolvedBy User?   @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([openedByUserId, createdAt(sort: Desc)])
  @@map("disputes")
}

model LedgerTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  referenceType String   @map("reference_type") @db.VarChar(60)
  referenceId   String?  @map("reference_id") @db.Uuid
  description   String   @db.VarChar(255)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor   User?         @relation("LedgerActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([actorUserId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  ledgerTransactionId String          @map("ledger_transaction_id") @db.Uuid
  walletAccountId     String?         @map("wallet_account_id") @db.Uuid
  accountCode         String          @map("account_code") @db.VarChar(60)
  entrySide           LedgerEntrySide @map("entry_side")
  amountPaisa         BigInt          @map("amount_paisa")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  walletAccount     WalletAccount?    @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)

  @@index([ledgerTransactionId])
  @@index([walletAccountId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

model WalletReconciliation {
  id                   String               @id @default(uuid()) @db.Uuid
  walletAccountId      String               @map("wallet_account_id") @db.Uuid
  cachedAvailablePaisa BigInt               @map("cached_available_paisa")
  ledgerAvailablePaisa BigInt               @map("ledger_available_paisa")
  differencePaisa      BigInt               @map("difference_paisa")
  status               ReconciliationStatus
  reviewedByUserId     String?              @map("reviewed_by_user_id") @db.Uuid
  reconciledAt         DateTime             @default(now()) @map("reconciled_at") @db.Timestamptz(6)
  resolvedAt           DateTime?            @map("resolved_at") @db.Timestamptz(6)
  notes                String?

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("ReconciliationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([walletAccountId, reconciledAt(sort: Desc)])
  @@index([status])
  @@map("wallet_reconciliations")
}
