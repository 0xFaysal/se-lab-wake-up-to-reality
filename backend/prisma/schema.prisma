generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED

  @@map("user_status")
}

enum UserRoleType {
  DRIVER
  PROVIDER
  MANAGER
  GUARD
  ADMIN

  @@map("user_role")
}

enum AccountOrigin {
  SELF_REGISTERED
  PROVIDER_CREATED_GUARD
  ADMIN_CREATED_GUARD
  PROVIDER_CREATED_MANAGER
  ADMIN_CREATED_MANAGER

  @@map("account_origin")
}

enum VerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("verification_status")
}

enum PropertyStatus {
  ACTIVE
  TEMPORARILY_CLOSED
  INACTIVE

  @@map("property_status")
}

enum ParkingSpotStatus {
  ACTIVE
  BLOCKED
  MAINTENANCE
  INACTIVE

  @@map("parking_spot_status")
}

enum ParkingResourceType {
  FIXED_SPACE
  SHARED_POOL

  @@map("parking_resource_type")
}

enum ParkingRightType {
  OWNERSHIP
  USE_ONLY
  COMMERCIAL_LEASE
  AUTHORIZED_OPERATION

  @@map("parking_right_type")
}

enum ParkingRightStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISPUTED
  REJECTED
  REVOKED
  EXPIRED

  @@map("parking_right_status")
}

enum ParkingListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SUSPENDED
  ENDED

  @@map("parking_listing_status")
}

enum ReservationHoldStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED

  @@map("reservation_hold_status")
}

enum ParkingAllocationStatus {
  HELD
  BOOKED
  RELEASED

  @@map("parking_allocation_status")
}

enum BookingStatus {
  PAYMENT_PENDING
  CONFIRMED
  CHECKED_IN
  CHECKOUT_REQUESTED
  PAYMENT_DUE
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  DISPUTED

  @@map("booking_status")
}

enum AccessCredentialStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED

  @@map("access_credential_status")
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("refund_status")
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID

  @@map("payout_status")
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  GUARD_ASSIGNMENT
  MANAGER_DELEGATION
  PROPERTY_GOVERNANCE
  PAYMENT_SUCCEEDED
  REFUND_PROCESSED
  PAYOUT_UPDATED
  DISPUTE_UPDATE

  @@map("notification_type")
}

enum DisputeCategory {
  PAYMENT
  ACCESS
  PARKING_CONDITION
  OVERCHARGE
  VEHICLE_DAMAGE
  OTHER

  @@map("dispute_category")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED

  @@map("dispute_status")
}

enum VehicleType {
  MOTORCYCLE
  SEDAN
  SUV
  MICROBUS

  @@map("vehicle_type")
}

enum GuardAssignmentStatus {
  PENDING_ACCEPTANCE
  ACTIVE
  SUSPENDED
  ENDED
  CANCELLED

  @@map("guard_assignment_status")
}

enum PropertyProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED

  @@map("property_provider_status")
}

enum BuildingManagerAssignmentStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  ENDED
  CANCELLED
  PENDING_RECONFIRMATION

  @@map("building_manager_assignment_status")
}

enum GovernanceVoteDecision {
  APPROVE
  REJECT

  @@map("governance_vote_decision")
}

enum ManagerDelegationStatus {
  PENDING_ACCEPTANCE
  ACTIVE
  SUSPENDED
  ENDED
  CANCELLED

  @@map("manager_delegation_status")
}

enum ManagerDelegationPermission {
  RESOURCE_VIEW
  LISTING_VIEW
  LISTING_MANAGE
  PRICE_MANAGE
  AVAILABILITY_MANAGE
  BOOKING_VIEW
  BOOKING_MANAGE
  IMAGE_MANAGE
  GUARD_VIEW
  GUARD_ADD_TO_PROPERTY
  GUARD_ASSIGN
  EARNINGS_VIEW
  REPORTS_VIEW

  @@map("manager_delegation_permission")
}

enum PropertyGuardMembershipStatus {
  PENDING_ACCEPTANCE
  ACTIVE
  SUSPENDED
  ENDED
  CANCELLED

  @@map("property_guard_membership_status")
}

enum PropertyChangeType {
  COMMON_RULES
  TEMPORARY_CLOSURE
  IDENTITY_LOCATION

  @@map("property_change_type")
}

enum PropertyChangeProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
  STALE
  CANCELLED

  @@map("property_change_proposal_status")
}

enum DomainAuditEventType {
  PROPERTY_PROVIDER_JOINED
  PROPERTY_PROVIDER_ENDED
  BUILDING_MANAGER_NOMINATED
  BUILDING_MANAGER_APPROVED
  BUILDING_MANAGER_REJECTED
  BUILDING_MANAGER_ACTIVATED
  BUILDING_MANAGER_ENDED
  PROPERTY_CHANGE_PROPOSED
  PROPERTY_CHANGE_APPROVED
  PROPERTY_CHANGE_REJECTED
  PROPERTY_CHANGE_APPLIED
  MANAGER_DELEGATION_CREATED
  MANAGER_DELEGATION_ACCEPTED
  MANAGER_PERMISSION_UPDATED
  MANAGER_DELEGATION_ENDED
  PROPERTY_GUARD_ADDED
  PROPERTY_GUARD_REMOVED
  PROVIDER_GUARD_ASSIGNED
  PROVIDER_GUARD_ASSIGNMENT_ENDED
  PROPERTY_MERGED
  PARKING_RESOURCE_CREATED
  PARKING_RIGHT_CLAIMED
  PARKING_RIGHT_VERIFIED
  LISTING_ACTIVATED
  LISTING_PAUSED
  LISTING_SUSPENDED
  QUOTE_CREATED
  HOLD_CREATED
  HOLD_EXPIRED
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_CHECKED_IN
  BOOKING_CHECKED_OUT
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_CREATED
  PAYOUT_REQUESTED
  PAYOUT_REVIEWED
  DISPUTE_CREATED
  DISPUTE_RESOLVED

  @@map("domain_audit_event_type")
}

enum AvailabilityExceptionType {
  BLOCKED
  SPECIAL_AVAILABLE

  @@map("availability_exception_type")
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  OWNER_OPERATIONAL_POLICY
  GUARD_OPERATIONAL_POLICY

  @@map("legal_document_type")
}

enum LegalAcceptanceSource {
  REGISTRATION
  FIRST_LOGIN
  POLICY_UPDATE
  OWNER_GUARD_CREATION
  GUARD_ASSIGNMENT_ACCEPTANCE
  ADMIN_ACTION

  @@map("legal_acceptance_source")
}

enum WalletAccountStatus {
  ACTIVE
  FROZEN
  CLOSED

  @@map("wallet_account_status")
}

enum LedgerEntrySide {
  DEBIT
  CREDIT

  @@map("ledger_entry_side")
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  RESOLVED
  MANUAL_REVIEW

  @@map("reconciliation_status")
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  fullName           String        @map("full_name") @db.VarChar(120)
  email              String        @unique @db.Citext
  phone              String        @unique @db.VarChar(20)
  passwordHash       String        @map("password_hash")
  status             UserStatus    @default(PENDING)
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  accountOrigin      AccountOrigin @default(SELF_REGISTERED) @map("account_origin")
  createdByUserId    String?       @map("created_by_user_id") @db.Uuid
  emailVerifiedAt    DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt    DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)

  creator                         User?                               @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdUsers                    User[]                              @relation("UserCreator")
  roles                           UserRole[]
  refreshSessions                 RefreshSession[]
  passwordResetTokens             PasswordResetToken[]
  vehicles                        Vehicle[]                           @relation("VehicleOwner")
  createdProperties               Property[]                          @relation("PropertyCreator")
  verifiedProperties              Property[]                          @relation("PropertyVerifier")
  providerMemberships             PropertyProvider[]                  @relation("PropertyProviderUser")
  verifiedProviderMemberships     PropertyProvider[]                  @relation("PropertyProviderVerifier")
  managerCandidates               PropertyBuildingManagerAssignment[] @relation("BuildingManagerCandidate")
  managerNominations              PropertyBuildingManagerAssignment[] @relation("BuildingManagerNominator")
  buildingManagerVotes            PropertyBuildingManagerVote[]       @relation("BuildingManagerVoter")
  managerDelegations              ProviderManagerDelegation[]         @relation("DelegationManager")
  createdGuardMemberships         PropertyGuardMembership[]           @relation("PropertyGuardAdder")
  propertyGuardMemberships        PropertyGuardMembership[]           @relation("PropertyGuardUser")
  createdProviderGuardAssignments ProviderGuardAssignment[]           @relation("ProviderGuardAssignmentCreator")
  proposedPropertyChanges         PropertyChangeProposal[]            @relation("PropertyChangeProposer")
  propertyChangeVotes             PropertyChangeVote[]                @relation("PropertyChangeVoter")
  domainAuditEvents               DomainAuditEvent[]                  @relation("DomainAuditActor")
  createdExceptions               AvailabilityException[]             @relation("ExceptionCreator")
  legalAcceptances                UserLegalAcceptance[]
  walletAccounts                  WalletAccount[]
  ledgerTransactions              LedgerTransaction[]                 @relation("LedgerActor")
  reconciliationsReviewed         WalletReconciliation[]              @relation("ReconciliationReviewer")
  heldParkingRights               ParkingRight[]                      @relation("ParkingRightHolder")
  grantedParkingRights            ParkingRight[]                      @relation("ParkingRightGrantor")
  verifiedParkingRights           ParkingRight[]                      @relation("ParkingRightVerifier")
  parkingListings                 ParkingListing[]                    @relation("ListingProvider")
  settlementListings              ParkingListing[]                    @relation("ListingSettlementRecipient")
  bookingQuotes                   BookingQuote[]                      @relation("QuoteDriver")
  reservationHolds                ReservationHold[]                   @relation("HoldDriver")
  driverBookings                  Booking[]                           @relation("BookingDriver")
  providerBookings                Booking[]                           @relation("BookingProvider")
  settlementBookings              Booking[]                           @relation("BookingSettlementRecipient")
  bookingPayments                 Payment[]                           @relation("PaymentPayer")
  requestedRefunds                Refund[]                            @relation("RefundRequester")
  payoutRequests                  PayoutRequest[]                     @relation("PayoutProvider")
  notifications                   Notification[]
  reviewsWritten                  Review[]                            @relation("ReviewDriver")
  reviewReplies                   Review[]                            @relation("ReviewProvider")
  disputesOpened                  Dispute[]                           @relation("DisputeOpenedBy")
  disputesResolved                Dispute[]                           @relation("DisputeResolvedBy")

  @@index([status])
  @@index([accountOrigin])
  @@index([createdByUserId])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model UserRole {
  userId    String       @map("user_id") @db.Uuid
  role      UserRoleType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  rememberDevice      Boolean   @default(false) @map("remember_device")
  userAgent           String?   @map("user_agent")
  ipHash              String?   @map("ip_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?   @unique @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy  RefreshSession? @relation("RefreshRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacedOld RefreshSession? @relation("RefreshRotation")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     String            @db.VarChar(30)
  title       String            @db.VarChar(150)
  contentHash String            @map("content_hash") @db.VarChar(128)
  effectiveAt DateTime          @map("effective_at") @db.Timestamptz(6)
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  acceptances UserLegalAcceptance[]

  @@unique([type, version])
  @@index([type, isActive])
  @@map("legal_documents")
}

model UserLegalAcceptance {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  legalDocumentId  String                @map("legal_document_id") @db.Uuid
  acceptanceSource LegalAcceptanceSource @map("acceptance_source")
  acceptedAt       DateTime              @default(now()) @map("accepted_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@index([userId])
  @@index([legalDocumentId])
  @@map("user_legal_acceptances")
}

model Vehicle {
  id                           String             @id @default(uuid()) @db.Uuid
  ownerUserId                  String             @map("owner_user_id") @db.Uuid
  vehicleType                  VehicleType        @map("vehicle_type")
  registrationNumber           String             @map("registration_number") @db.VarChar(50)
  normalizedRegistrationNumber String             @unique @map("normalized_registration_number") @db.VarChar(50)
  brand                        String?            @db.VarChar(80)
  model                        String?            @db.VarChar(80)
  color                        String?            @db.VarChar(40)
  heightCm                     Int?               @map("height_cm")
  widthCm                      Int?               @map("width_cm")
  lengthCm                     Int?               @map("length_cm")
  verificationStatus           VerificationStatus @default(PENDING) @map("verification_status")
  isDefault                    Boolean            @default(false) @map("is_default")
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  owner    User           @relation("VehicleOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  quotes   BookingQuote[]
  bookings Booking[]

  @@index([ownerUserId])
  @@index([vehicleType, verificationStatus])
  @@map("vehicles")
}

model Property {
  id                            String             @id @default(uuid()) @db.Uuid
  createdByUserId               String             @map("created_by_user_id") @db.Uuid
  name                          String             @db.VarChar(150)
  normalizedName                String             @map("normalized_name") @db.VarChar(150)
  description                   String?
  publicArea                    String             @map("public_area") @db.VarChar(120)
  approximateAddress            String             @map("approximate_address") @db.VarChar(255)
  exactAddressCiphertext        String             @map("exact_address_ciphertext")
  exactAddressIv                String?            @map("exact_address_iv") @db.VarChar(32)
  exactAddressTag               String?            @map("exact_address_tag") @db.VarChar(32)
  latitude                      Decimal            @db.Decimal(9, 6)
  longitude                     Decimal            @db.Decimal(9, 6)
  entranceLatitude              Decimal?           @map("entrance_latitude") @db.Decimal(9, 6)
  entranceLongitude             Decimal?           @map("entrance_longitude") @db.Decimal(9, 6)
  accessInstructionsCiphertext  String?            @map("access_instructions_ciphertext")
  accessInstructionsIv          String?            @map("access_instructions_iv") @db.VarChar(32)
  accessInstructionsTag         String?            @map("access_instructions_tag") @db.VarChar(32)
  addressFingerprint            String?            @map("address_fingerprint") @db.VarChar(64)
  visitorIdentificationRequired Boolean            @default(false) @map("visitor_identification_required")
  vehicleHeightLimitCm          Int?               @map("vehicle_height_limit_cm")
  entryCutoffLocalTime          DateTime?          @map("entry_cutoff_local_time") @db.Time(6)
  generalParkingRules           String?            @map("general_parking_rules")
  commonSafetyRules             String?            @map("common_safety_rules")
  temporaryClosureReason        String?            @map("temporary_closure_reason") @db.VarChar(500)
  temporaryClosedAt             DateTime?          @map("temporary_closed_at") @db.Timestamptz(6)
  temporaryClosedUntil          DateTime?          @map("temporary_closed_until") @db.Timestamptz(6)
  version                       Int                @default(1)
  canonicalPropertyId           String?            @map("canonical_property_id") @db.Uuid
  archivedAt                    DateTime?          @map("archived_at") @db.Timestamptz(6)
  verificationStatus            VerificationStatus @default(DRAFT) @map("verification_status")
  status                        PropertyStatus     @default(INACTIVE)
  verifiedByAdminId             String?            @map("verified_by_admin_id") @db.Uuid
  verifiedAt                    DateTime?          @map("verified_at") @db.Timestamptz(6)
  rejectionReason               String?            @map("rejection_reason")
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                     DateTime?          @map("deleted_at") @db.Timestamptz(6)

  createdBy                  User                                @relation("PropertyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  verifiedByAdmin            User?                               @relation("PropertyVerifier", fields: [verifiedByAdminId], references: [id], onDelete: Restrict)
  canonicalProperty          Property?                           @relation("PropertyCanonicalMerge", fields: [canonicalPropertyId], references: [id], onDelete: Restrict)
  mergedDuplicates           Property[]                          @relation("PropertyCanonicalMerge")
  images                     PropertyImage[]
  providerMemberships        PropertyProvider[]
  buildingManagerAssignments PropertyBuildingManagerAssignment[]
  managerDelegations         ProviderManagerDelegation[]
  guardMemberships           PropertyGuardMembership[]
  changeProposals            PropertyChangeProposal[]
  domainAuditEvents          DomainAuditEvent[]
  parkingSpots               ParkingSpot[]
  bookings                   Booking[]

  @@index([createdByUserId])
  @@index([normalizedName, publicArea])
  @@index([addressFingerprint])
  @@index([canonicalPropertyId])
  @@index([verificationStatus, status, publicArea])
  @@index([latitude, longitude])
  @@map("properties")
}

model PropertyProvider {
  id                 String                 @id @default(uuid()) @db.Uuid
  propertyId         String                 @map("property_id") @db.Uuid
  providerUserId     String                 @map("provider_user_id") @db.Uuid
  status             PropertyProviderStatus @default(ACTIVE)
  verificationStatus VerificationStatus     @default(PENDING) @map("verification_status")
  joinedAt           DateTime               @default(now()) @map("joined_at") @db.Timestamptz(6)
  verifiedByAdminId  String?                @map("verified_by_admin_id") @db.Uuid
  verifiedAt         DateTime?              @map("verified_at") @db.Timestamptz(6)
  rejectionReason    String?                @map("rejection_reason") @db.VarChar(500)
  endedAt            DateTime?              @map("ended_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  property             Property                      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  provider             User                          @relation("PropertyProviderUser", fields: [providerUserId], references: [id], onDelete: Restrict)
  verifiedByAdmin      User?                         @relation("PropertyProviderVerifier", fields: [verifiedByAdminId], references: [id], onDelete: Restrict)
  buildingManagerVotes PropertyBuildingManagerVote[]
  managerDelegations   ProviderManagerDelegation[]
  guardAssignments     ProviderGuardAssignment[]
  changeVotes          PropertyChangeVote[]
  parkingSpots         ParkingSpot[]
  parkingRights        ParkingRight[]
  listings             ParkingListing[]

  @@unique([propertyId, providerUserId])
  @@index([propertyId, status, verificationStatus])
  @@index([providerUserId, status, verificationStatus])
  @@map("property_providers")
}

model PropertyBuildingManagerAssignment {
  id                String                          @id @default(uuid()) @db.Uuid
  propertyId        String                          @map("property_id") @db.Uuid
  candidateUserId   String                          @map("candidate_user_id") @db.Uuid
  nominatedByUserId String                          @map("nominated_by_user_id") @db.Uuid
  status            BuildingManagerAssignmentStatus @default(PENDING_APPROVAL)
  nominatedAt       DateTime                        @default(now()) @map("nominated_at") @db.Timestamptz(6)
  activatedAt       DateTime?                       @map("activated_at") @db.Timestamptz(6)
  endedAt           DateTime?                       @map("ended_at") @db.Timestamptz(6)
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  property    Property                      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  candidate   User                          @relation("BuildingManagerCandidate", fields: [candidateUserId], references: [id], onDelete: Restrict)
  nominatedBy User                          @relation("BuildingManagerNominator", fields: [nominatedByUserId], references: [id], onDelete: Restrict)
  votes       PropertyBuildingManagerVote[]

  @@index([propertyId, status])
  @@index([candidateUserId, status])
  @@map("property_building_manager_assignments")
}

model PropertyBuildingManagerVote {
  id                   String                 @id @default(uuid()) @db.Uuid
  assignmentId         String                 @map("assignment_id") @db.Uuid
  providerMembershipId String                 @map("provider_membership_id") @db.Uuid
  voterUserId          String                 @map("voter_user_id") @db.Uuid
  decision             GovernanceVoteDecision
  reason               String?                @db.VarChar(500)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  assignment         PropertyBuildingManagerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  providerMembership PropertyProvider                  @relation(fields: [providerMembershipId], references: [id], onDelete: Restrict)
  voter              User                              @relation("BuildingManagerVoter", fields: [voterUserId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, providerMembershipId])
  @@index([assignmentId, decision])
  @@map("property_building_manager_votes")
}

model ProviderManagerDelegation {
  id                          String                  @id @default(uuid()) @db.Uuid
  grantorProviderMembershipId String                  @map("grantor_provider_membership_id") @db.Uuid
  managerUserId               String                  @map("manager_user_id") @db.Uuid
  propertyId                  String                  @map("property_id") @db.Uuid
  status                      ManagerDelegationStatus @default(PENDING_ACCEPTANCE)
  validFrom                   DateTime?               @map("valid_from") @db.Timestamptz(6)
  validUntil                  DateTime?               @map("valid_until") @db.Timestamptz(6)
  invitedAt                   DateTime                @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt                  DateTime?               @map("accepted_at") @db.Timestamptz(6)
  endedAt                     DateTime?               @map("ended_at") @db.Timestamptz(6)
