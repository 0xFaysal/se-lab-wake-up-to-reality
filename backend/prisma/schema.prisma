  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByAdmin User @relation("NotificationCampaignCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt, createdAt(sort: Desc)])
  @@index([audience, status])
  @@map("notification_campaigns")
}

model EmailTemplate {
  id                   String            @id @default(uuid()) @db.Uuid
  type                 EmailTemplateType
  name                 String            @db.VarChar(150)
  version              Int               @default(1)
  subject              String            @db.VarChar(200)
  preheader            String?           @db.VarChar(250)
  htmlBody             String            @map("html_body")
  textBody             String            @map("text_body")
  allowedVariables     String[]          @default([]) @map("allowed_variables")
  status               ContentStatus     @default(DRAFT)
  supersedesTemplateId String?           @map("supersedes_template_id") @db.Uuid
  createdByAdminId     String            @map("created_by_admin_id") @db.Uuid
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByAdmin User            @relation("EmailTemplateCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  supersedes     EmailTemplate?  @relation("EmailTemplateVersion", fields: [supersedesTemplateId], references: [id], onDelete: Restrict)
  replacements   EmailTemplate[] @relation("EmailTemplateVersion")
  campaigns      EmailCampaign[]
  deliveries     EmailDelivery[]

  @@unique([type, version])
  @@index([type, status, version(sort: Desc)])
  @@index([supersedesTemplateId])
  @@map("email_templates")
}

model EmailCampaign {
  id                      String              @id @default(uuid()) @db.Uuid
  templateId              String              @map("template_id") @db.Uuid
  title                   String              @db.VarChar(150)
  audience                ContentAudience
  status                  EmailCampaignStatus @default(DRAFT)
  subjectOverride         String?             @map("subject_override") @db.VarChar(200)
  htmlBodyOverride        String?             @map("html_body_override")
  textBodyOverride        String?             @map("text_body_override")
  estimatedRecipientCount Int                 @default(0) @map("estimated_recipient_count")
  scheduledAt             DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  processingAt            DateTime?           @map("processing_at") @db.Timestamptz(6)
  sentAt                  DateTime?           @map("sent_at") @db.Timestamptz(6)
  failedAt                DateTime?           @map("failed_at") @db.Timestamptz(6)
  cancelledAt             DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  createdByAdminId        String              @map("created_by_admin_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  template       EmailTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdByAdmin User            @relation("EmailCampaignCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  deliveries     EmailDelivery[]

  @@index([status, scheduledAt, createdAt(sort: Desc)])
  @@index([audience, status])
  @@map("email_campaigns")
}

model EmailDelivery {
  id              String              @id @default(uuid()) @db.Uuid
  campaignId      String?             @map("campaign_id") @db.Uuid
  templateId      String              @map("template_id") @db.Uuid
  recipientUserId String?             @map("recipient_user_id") @db.Uuid
  recipientEmail  String              @map("recipient_email") @db.Citext
  subject         String              @db.VarChar(200)
  htmlBody        String              @map("html_body")
  textBody        String              @map("text_body")
  status          EmailDeliveryStatus @default(QUEUED)
  attemptCount    Int                 @default(0) @map("attempt_count")
  providerMessage String?             @map("provider_message") @db.VarChar(500)
  availableAt     DateTime            @default(now()) @map("available_at") @db.Timestamptz(6)
  processingAt    DateTime?           @map("processing_at") @db.Timestamptz(6)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(6)
  failedAt        DateTime?           @map("failed_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign  EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  template  EmailTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipient User?          @relation("EmailDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([campaignId, recipientUserId])
  @@index([status, availableAt, createdAt])
  @@index([recipientEmail, createdAt(sort: Desc)])
  @@map("email_deliveries")
}

model PlatformFeeRule {
  id               String                @id @default(uuid()) @db.Uuid
  scopeType        PlatformFeeScopeType  @map("scope_type")
  scopeId          String?               @map("scope_id") @db.Uuid
  feeType          PlatformFeeType       @map("fee_type")
  percentageBps    Int?                  @map("percentage_bps")
  fixedAmountPaisa BigInt?               @map("fixed_amount_paisa")
  effectiveFrom    DateTime              @map("effective_from") @db.Timestamptz(6)
  effectiveUntil   DateTime?             @map("effective_until") @db.Timestamptz(6)
  status           PlatformFeeRuleStatus @default(DRAFT)
  reason           String                @db.VarChar(500)
  version          Int                   @default(1)
  supersedesRuleId String?               @map("supersedes_rule_id") @db.Uuid
  createdByAdminId String                @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  activatedAt      DateTime?             @map("activated_at") @db.Timestamptz(6)
  archivedAt       DateTime?             @map("archived_at") @db.Timestamptz(6)

  createdByAdmin User              @relation("PlatformFeeRuleCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  supersedes     PlatformFeeRule?  @relation("PlatformFeeRuleVersion", fields: [supersedesRuleId], references: [id], onDelete: Restrict)
  replacements   PlatformFeeRule[] @relation("PlatformFeeRuleVersion")
  quotes         BookingQuote[]

  @@index([scopeType, scopeId, status, effectiveFrom(sort: Desc)])
  @@index([status, effectiveFrom, effectiveUntil])
  @@index([supersedesRuleId])
  @@map("platform_fee_rules")
}
