generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED

  @@map("user_status")
}

enum UserRoleType {
  DRIVER
  PARKING_OWNER
  GUARD
  ADMIN

  @@map("user_role")
}

enum AccountOrigin {
  SELF_REGISTERED
  OWNER_CREATED_GUARD
  ADMIN_CREATED_GUARD

  @@map("account_origin")
}

enum VerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("verification_status")
}

enum PropertyStatus {
  ACTIVE
  TEMPORARILY_CLOSED
  INACTIVE

  @@map("property_status")
}

enum ParkingSpotStatus {
  ACTIVE
  BLOCKED
  MAINTENANCE
  INACTIVE

  @@map("parking_spot_status")
}

enum VehicleType {
  MOTORCYCLE
  SEDAN
  SUV
  MICROBUS
  @@map("vehicle_type")
}

enum GuardAssignmentStatus {
  PENDING_ACCEPTANCE
  ACTIVE
  SUSPENDED
  ENDED
  CANCELLED

  @@map("guard_assignment_status")
}

enum AvailabilityExceptionType {
  BLOCKED
  SPECIAL_AVAILABLE

  @@map("availability_exception_type")
}


enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  OWNER_OPERATIONAL_POLICY
  GUARD_OPERATIONAL_POLICY

  @@map("legal_document_type")
}

enum LegalAcceptanceSource {
  REGISTRATION
  FIRST_LOGIN
  POLICY_UPDATE
  OWNER_GUARD_CREATION
  GUARD_ASSIGNMENT_ACCEPTANCE
  ADMIN_ACTION

  @@map("legal_acceptance_source")
}

enum WalletAccountStatus {
  ACTIVE
  FROZEN
  CLOSED

  @@map("wallet_account_status")
}

enum LedgerEntrySide {
  DEBIT
  CREDIT

  @@map("ledger_entry_side")
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  RESOLVED
  MANUAL_REVIEW

  @@map("reconciliation_status")
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  fullName            String        @map("full_name") @db.VarChar(120)
  email               String        @unique @db.Citext
  phone               String        @unique @db.VarChar(20)
  passwordHash        String        @map("password_hash")
  status              UserStatus    @default(PENDING)
  mustChangePassword  Boolean       @default(false) @map("must_change_password")
  accountOrigin       AccountOrigin @default(SELF_REGISTERED) @map("account_origin")
  createdByUserId     String?       @map("created_by_user_id") @db.Uuid
  emailVerifiedAt     DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt         DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)

  creator                 User?                     @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdUsers            User[]                    @relation("UserCreator")
  roles                   UserRole[]
  refreshSessions         RefreshSession[]
  passwordResetTokens     PasswordResetToken[]
  vehicles                Vehicle[]                 @relation("VehicleOwner")
  ownedProperties         Property[]                @relation("PropertyOwner")
  verifiedProperties      Property[]                @relation("PropertyVerifier")
  guardAssignments        PropertyGuardAssignment[] @relation("AssignedGuard")
  createdGuardAssignments PropertyGuardAssignment[] @relation("GuardAssignmentCreator")
  createdExceptions       AvailabilityException[]   @relation("ExceptionCreator")
  legalAcceptances        UserLegalAcceptance[]
  walletAccounts          WalletAccount[]
  ledgerTransactions      LedgerTransaction[]       @relation("LedgerActor")
  reconciliationsReviewed WalletReconciliation[]    @relation("ReconciliationReviewer")

  @@index([status])
  @@index([accountOrigin])
  @@index([createdByUserId])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model UserRole {
  userId    String       @map("user_id") @db.Uuid
  role      UserRoleType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  rememberDevice      Boolean   @default(false) @map("remember_device")
  userAgent           String?   @map("user_agent")
  ipHash              String?   @map("ip_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?   @unique @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy  RefreshSession? @relation("RefreshRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacedOld RefreshSession? @relation("RefreshRotation")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     String            @db.VarChar(30)
  title       String            @db.VarChar(150)
  contentHash String            @map("content_hash") @db.VarChar(128)
  effectiveAt DateTime          @map("effective_at") @db.Timestamptz(6)
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  acceptances UserLegalAcceptance[]

  @@unique([type, version])
  @@index([type, isActive])
  @@map("legal_documents")
}

model UserLegalAcceptance {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  legalDocumentId  String                @map("legal_document_id") @db.Uuid
  acceptanceSource LegalAcceptanceSource @map("acceptance_source")
  acceptedAt       DateTime              @default(now()) @map("accepted_at") @db.Timestamptz(6)

  user User @relation( fields: [userId],references: [id], onDelete: Restrict)
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id],onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@index([userId])
  @@index([legalDocumentId])
  @@map("user_legal_acceptances")
}

model Vehicle {
  id                           String              @id @default(uuid()) @db.Uuid
  ownerUserId                  String              @map("owner_user_id") @db.Uuid
  vehicleType                  VehicleType         @map("vehicle_type")
  registrationNumber           String              @map("registration_number") @db.VarChar(50)
  normalizedRegistrationNumber String              @unique @map("normalized_registration_number") @db.VarChar(50)
  brand                        String?             @db.VarChar(80)
  model                        String?             @db.VarChar(80)
  color                        String?             @db.VarChar(40)
  heightCm                     Int?                @map("height_cm")
  widthCm                      Int?                @map("width_cm")
  lengthCm                     Int?                @map("length_cm")
  verificationStatus           VerificationStatus @default(PENDING) @map("verification_status")
  isDefault                    Boolean             @default(false) @map("is_default")
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                    DateTime?           @map("deleted_at") @db.Timestamptz(6)

  owner User @relation("VehicleOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  @@index([vehicleType, verificationStatus])
  @@map("vehicles")
}

model Property {
  id                           String              @id @default(uuid()) @db.Uuid
  ownerUserId                  String              @map("owner_user_id") @db.Uuid
  name                         String              @db.VarChar(150)
  description                  String?
  publicArea                   String              @map("public_area") @db.VarChar(120)
  approximateAddress           String              @map("approximate_address") @db.VarChar(255)
  exactAddressCiphertext       String              @map("exact_address_ciphertext")
  exactAddressIv               String?             @map("exact_address_iv") @db.VarChar(32)
  exactAddressTag              String?             @map("exact_address_tag") @db.VarChar(32)
  latitude                     Decimal             @db.Decimal(9, 6)
  longitude                    Decimal             @db.Decimal(9, 6)
  entranceLatitude             Decimal?            @map("entrance_latitude") @db.Decimal(9, 6)
  entranceLongitude            Decimal?            @map("entrance_longitude") @db.Decimal(9, 6)
  accessInstructionsCiphertext String?             @map("access_instructions_ciphertext")
  accessInstructionsIv         String?             @map("access_instructions_iv") @db.VarChar(32)
  accessInstructionsTag        String?             @map("access_instructions_tag") @db.VarChar(32)
  verificationStatus           VerificationStatus @default(DRAFT) @map("verification_status")
  status                       PropertyStatus      @default(INACTIVE)
  verifiedByAdminId            String?             @map("verified_by_admin_id") @db.Uuid
  verifiedAt                   DateTime?           @map("verified_at") @db.Timestamptz(6)
  rejectionReason              String?             @map("rejection_reason")
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                    DateTime?           @map("deleted_at") @db.Timestamptz(6)

  owner            User                      @relation("PropertyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  verifiedByAdmin  User?                     @relation("PropertyVerifier", fields: [verifiedByAdminId], references: [id], onDelete: Restrict)
  images           PropertyImage[]
  guardAssignments PropertyGuardAssignment[]
  parkingSpots     ParkingSpot[]

  @@index([ownerUserId])
  @@index([verificationStatus, status, publicArea])
  @@index([latitude, longitude])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  storageKey String   @unique @map("storage_key")
  imageType  String   @map("image_type") @db.VarChar(30)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_images")
}

model PropertyGuardAssignment {
  id              String                @id @default(uuid()) @db.Uuid
  propertyId      String                @map("property_id") @db.Uuid
  guardUserId     String                @map("guard_user_id") @db.Uuid
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  status          GuardAssignmentStatus @default(PENDING_ACCEPTANCE)
  shiftStart      DateTime?             @map("shift_start") @db.Time(6)
  shiftEnd        DateTime?             @map("shift_end") @db.Time(6)
  invitedAt       DateTime              @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz(6)
  assignedAt      DateTime?             @map("assigned_at") @db.Timestamptz(6)
  endedAt         DateTime?             @map("ended_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guard     User     @relation("AssignedGuard", fields: [guardUserId], references: [id], onDelete: Restrict)
  createdBy User     @relation("GuardAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([propertyId, status])
  @@index([guardUserId, status])
  @@index([createdByUserId])
  @@map("property_guard_assignments")
}

model ParkingSpot {
  id                            String            @id @default(uuid()) @db.Uuid
  propertyId                    String            @map("property_id") @db.Uuid
  spotCode                      String            @map("spot_code") @db.VarChar(30)
  supportedVehicleType          VehicleType       @map("supported_vehicle_type")
  hourlyRatePaisa               BigInt            @map("hourly_rate_paisa")
  minimumBookingMinutes         Int               @default(60) @map("minimum_booking_minutes")
  maximumBookingMinutes         Int               @default(720) @map("maximum_booking_minutes")
  bookingBufferMinutes          Int               @default(0) @map("booking_buffer_minutes")
  gracePeriodMinutes            Int               @default(15) @map("grace_period_minutes")
  overtimeMultiplierBasisPoints Int               @default(15000) @map("overtime_multiplier_basis_points")
  minimumDepositPaisa           BigInt            @default(10000) @map("minimum_deposit_paisa")
  status                        ParkingSpotStatus @default(INACTIVE)
  isCovered                     Boolean           @default(false) @map("is_covered")
  hasCctv                       Boolean           @default(false) @map("has_cctv")
  hasGuard                      Boolean           @default(false) @map("has_guard")
  maxHeightCm                   Int?              @map("max_height_cm")
  maxWidthCm                    Int?              @map("max_width_cm")
  maxLengthCm                   Int?              @map("max_length_cm")
  createdAt                     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                     DateTime?         @map("deleted_at") @db.Timestamptz(6)

  property               Property                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  facilities             ParkingSpotFacility[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]

  @@unique([propertyId, spotCode])
  @@index([propertyId])
  @@index([status, supportedVehicleType, hourlyRatePaisa])
  @@map("parking_spots")
}

model ParkingFacility {
  id          Int    @id @default(autoincrement()) @db.SmallInt
  code        String @unique @db.VarChar(40)
  displayName String @map("display_name") @db.VarChar(80)

  parkingSpots ParkingSpotFacility[]

  @@map("parking_facilities")
}

model ParkingSpotFacility {
  parkingSpotId String @map("parking_spot_id") @db.Uuid
  facilityId    Int    @map("facility_id") @db.SmallInt

  parkingSpot ParkingSpot     @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)
  facility   ParkingFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@id([parkingSpotId, facilityId])
  @@map("parking_spot_facilities")
}

model AvailabilityRule {
  id             String    @id @default(uuid()) @db.Uuid
  parkingSpotId  String    @map("parking_spot_id") @db.Uuid
  dayOfWeek      Int       @map("day_of_week") @db.SmallInt
  startLocalTime DateTime  @map("start_local_time") @db.Time(6)
  endLocalTime   DateTime  @map("end_local_time") @db.Time(6)
  validFrom      DateTime  @map("valid_from") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)

  @@index([parkingSpotId, dayOfWeek, validFrom, validUntil])
  @@map("availability_rules")
}

model AvailabilityException {
  id              String                    @id @default(uuid()) @db.Uuid
  parkingSpotId   String                    @map("parking_spot_id") @db.Uuid
  startsAt        DateTime                  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime                  @map("ends_at") @db.Timestamptz(6)
  exceptionType   AvailabilityExceptionType @map("exception_type")
  reason          String?                   @db.VarChar(255)
  createdByUserId String                    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  parkingSpot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("ExceptionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([parkingSpotId, startsAt, endsAt])
  @@map("availability_exceptions")
}

model WalletAccount {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  currency              String              @default("BDT") @db.Char(3)
  status                WalletAccountStatus @default(ACTIVE)
  availableBalancePaisa BigInt              @default(0) @map("available_balance_paisa")
  pendingBalancePaisa   BigInt              @default(0) @map("pending_balance_paisa")
  heldBalancePaisa      BigInt              @default(0) @map("held_balance_paisa")
  balanceVersion        Int                 @default(1) @map("balance_version")
  lastReconciledAt      DateTime?           @map("last_reconciled_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries   LedgerEntry[]
  reconciliations WalletReconciliation[]

  @@unique([userId, currency])
  @@index([status])
  @@map("wallet_accounts")
}

model LedgerTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  referenceType String   @map("reference_type") @db.VarChar(60)
  referenceId   String?  @map("reference_id") @db.Uuid
  description   String   @db.VarChar(255)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor   User?         @relation("LedgerActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([actorUserId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  ledgerTransactionId String          @map("ledger_transaction_id") @db.Uuid
  walletAccountId     String?         @map("wallet_account_id") @db.Uuid
  accountCode         String          @map("account_code") @db.VarChar(60)
  entrySide           LedgerEntrySide @map("entry_side")
  amountPaisa         BigInt          @map("amount_paisa")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  walletAccount     WalletAccount?    @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)

  @@index([ledgerTransactionId])
  @@index([walletAccountId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

model WalletReconciliation {
  id                   String               @id @default(uuid()) @db.Uuid
  walletAccountId      String               @map("wallet_account_id") @db.Uuid
  cachedAvailablePaisa BigInt               @map("cached_available_paisa")
  ledgerAvailablePaisa BigInt               @map("ledger_available_paisa")
  differencePaisa      BigInt               @map("difference_paisa")
  status               ReconciliationStatus
  reviewedByUserId     String?              @map("reviewed_by_user_id") @db.Uuid
  reconciledAt         DateTime             @default(now()) @map("reconciled_at") @db.Timestamptz(6)
  resolvedAt           DateTime?            @map("resolved_at") @db.Timestamptz(6)
  notes                String?

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("ReconciliationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([walletAccountId, reconciledAt(sort: Desc)])
  @@index([status])
  @@map("wallet_reconciliations")
}
