NODE_ENV=development
PORT=4000
APP_NAME=ParkEase API
LOG_LEVEL=debug
DATABASE_URL=postgresql://parkease:parkease_dev_password@localhost:5432/parkease?schema=public
# Use a separate migrated database before running the integration suite.
TEST_DATABASE_URL=postgresql://parkease:parkease_dev_password@localhost:5432/parkease_test?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
PASSWORD_RESET_URL=http://localhost:3000/reset-password
TRUST_PROXY_HOPS=0
# Use none only when frontend and API are on different sites; production cookies remain Secure.
COOKIE_SAME_SITE=lax
ENABLE_API_DOCS=true

JWT_ACCESS_SECRET=replace-with-an-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
VERIFICATION_CODE_SECRET=replace-with-a-dedicated-verification-secret-32-chars-minimum
AUTH_METADATA_HASH_SECRET=replace-with-a-dedicated-metadata-secret-32-chars-minimum
PROPERTY_ADDRESS_FINGERPRINT_SECRET=replace-with-a-dedicated-property-fingerprint-secret
DATA_ENCRYPTION_KEY=replace-with-a-unique-64-character-hex-key
JWT_ISSUER=parkease-api
JWT_AUDIENCE=parkease-client
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_SHORT_DAYS=1
JWT_REFRESH_LONG_DAYS=30

PASSWORD_RESET_EXPIRES_MINUTES=15
VERIFICATION_CODE_EXPIRES_MINUTES=10

# Use Resend's HTTPS API on production hosts that block outbound SMTP.
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM_ADDRESS=notifications@your-verified-domain.com

# Gmail SMTP remains available for local development.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USERNAME=your-account@gmail.com
EMAIL_PASSWORD=replace-with-google-app-password
# Development runs the delivery processor inside the API process. In production,
# set this to false on the API and run `npm run worker:email` as a separate service.
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_POLL_INTERVAL_MS=5000

# Cloudinary credentials used only by the backend for Property image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio Programmable Messaging. Required for production phone verification.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+15005550006

# Local testing only. Keep false in staging and production.
EXPOSE_DEVELOPMENT_AUTH_CODES=true

SEED_ADMIN_EMAIL=admin@parkease.local
SEED_ADMIN_PHONE=+8801700000000
SEED_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!

# Development-only polished demo dataset (npm run db:seed:demo).
DEMO_USER_PASSWORD=ReplaceWithStrongDemoPassword123!
DEMO_ACCESS_CREDENTIAL=replace-with-a-demo-access-credential-at-least-32-characters
DEMO_EMAIL_DOMAIN=example.test
